{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run db:push && next build",
    "test:messages": "tsx --test scripts/messages.test.ts scripts/install-messages.test.ts",
    "test:app-pages": "tsx --test scripts/app-pages.test.ts scripts/patchsmith-origin.test.ts",
    "test:patchsmith-handler": "tsx --test scripts/patchsmith-handler.test.ts",
    "start": "next start",
    "lint": "vp lint .",
    "format": "vp fmt .",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/push-db.mjs",
    "db:push:force": "drizzle-kit push --force",
    "db:plan": "drizzle-kit push --explain --verbose",
    "test:db-push": "node --test scripts/schema-plan.test.mjs scripts/read-schema-plan.test.mjs",
    "test:db-config": "node --test scripts/database-url.test.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test:db": "tsx scripts/test-db.ts",
    "test:setup-protection": "tsx scripts/test-setup-protection.ts",
    "test:agent": "tsx scripts/test-agent.ts",
    "test:agent-rpc": "tsx scripts/test-agent-rpc.ts",
    "test:agent-chats": "tsx scripts/test-agent-chats.ts",
    "test:rpc": "tsx scripts/test-rpc.ts"
  },
  "dependencies": {
