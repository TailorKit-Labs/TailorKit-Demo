DATABASE_URL=postgresql://crm:crm@localhost:5432/crm
# Public development-only key: NEVER use this value in a deployed environment.
# Before deploying, generate a private key with: openssl rand -base64 32
BETTER_AUTH_SECRET=local-demo-secret-change-for-production-32
BETTER_AUTH_URL=http://localhost:3000

# Agent: use a Vercel AI Gateway API key or a locally pulled VERCEL_OIDC_TOKEN.
# On Vercel, leave the API key unset to use automatic OIDC authentication.
AI_GATEWAY_API_KEY=
# Optional: any tool-capable model available through AI Gateway.
AI_GATEWAY_MODEL=openai/gpt-6-luna

# Patchsmith project key (server only), required to install Messages during setup.
PATCHSMITH_PROJECT_KEY=
